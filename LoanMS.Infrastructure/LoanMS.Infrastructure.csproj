<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core 9.x — stable, fully compatible with all providers below -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"        Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Npgsql 9.x targets EF Core 9.x — compatible -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"  Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Data Protection (IDataProtector/IDataProtectionProvider) — needed for AiKeyStore encryption; not implicitly available in a plain class-library SDK project -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <!-- HTTP Client (IHttpClientFactory for AI providers) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Caching -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory"              Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <!-- Email — MailKit replaces System.Net.Mail for production -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- File storage — S3-backed document uploads (see IFileStorageService /
         S3FileStorageService). Added because loan/DSA document uploads were
         writing to the ECS Fargate container's local disk, which is
         ephemeral and wiped on every deploy/restart/scale event.
         NOTE: this exact version could not be verified against NuGet from
         the sandbox this change was written in (no NuGet network access
         there) — confirm/bump to the latest 3.7.x patch before deploying. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.405.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LoanMS.Application\LoanMS.Application.csproj" />
    <ProjectReference Include="..\LoanMS.Domain\LoanMS.Domain.csproj" />
  </ItemGroup>
</Project>
